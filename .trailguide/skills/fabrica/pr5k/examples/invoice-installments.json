  "overview": {
    "headline": "Let clients pay an invoice in installments",
    "capabilities": [
      {
        "group": "Invoices",
        "icon": "task",
        "subgroups": [
          {
            "group": "Split an invoice into installments",
            "items": [
              "Pick 2 to 12 installments and how often they fall due: weekly, every two weeks or monthly.",
              "Amounts split evenly, and the last installment takes any leftover cents."
            ]
          },
          {
            "group": "Track what is still owed",
            "items": [
              "An invoice shows `draft`, `sent`, `partly paid`, `paid` or `void` instead of a paid checkbox.",
              "Each installment shows its due date and whether it is paid."
            ]
          },
          {
            "group": "Change a plan after sending",
            "items": [
              "Move an unpaid installment to a new date. The client gets a fresh link."
            ]
          }
        ]
      },
      {
        "group": "Payments",
        "icon": "status",
        "subgroups": [
          {
            "group": "Pay one installment at a time",
            "items": [
              "The client's payment link opens on the next installment due, not the whole amount.",
              "Paying the last installment marks the invoice `paid`."
            ]
          },
          {
            "group": "Get reminded before a due date",
            "items": [
              "Clients get an email three days before each installment is due."
            ]
          }
        ]
      }
    ]
  },
