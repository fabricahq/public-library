{
  "reviewers": {
    "check-acceptance-criteria": {
      "summary": "Checks the change against the known acceptance criteria and product decisions",
      "agent": {
        "harness": "claude-code",
        "model": "opus",
        "effort": "high"
      },
      "focus": "focus/check-acceptance-criteria.md"
    },
    "check-correctness": {
      "summary": "Traces concrete inputs through the new logic to find wrong results",
      "agent": {
        "harness": "codex",
        "model": "gpt-6-astra",
        "effort": "high"
      },
      "focus": "focus/check-correctness.md"
    },
    "check-security": {
      "summary": "Checks trust boundaries, secrets, injection, and tenant isolation",
      "agent": {
        "harness": "codex",
        "model": "gpt-6-astra",
        "effort": "high"
      },
      "focus": "focus/check-security.md"
    },
    "check-rules": {
      "summary": "Checks the change against the repository's own rules and agent instructions",
      "agent": {
        "harness": "claude-code",
        "model": "opus",
        "effort": "default"
      },
      "focus": "focus/check-rules.md"
    },
    "check-docs": {
      "summary": "Checks that the docs still match the code after this change",
      "agent": {
        "harness": "claude-code",
        "model": "opus",
        "effort": "default"
      },
      "focus": "focus/check-docs.md"
    },
    "check-supportability": {
      "summary": "Checks that failures surface, can be traced, and can be recovered",
      "agent": {
        "harness": "codex",
        "model": "gpt-6.1-sol",
        "effort": "high"
      },
      "focus": "focus/check-supportability.md"
    },
    "check-performance": {
      "summary": "Flags only bottlenecks too large for the change's real workload",
      "agent": {
        "harness": "codex",
        "model": "gpt-6.1-sol",
        "effort": "high"
      },
      "focus": "focus/check-performance.md"
    },
    "check-architecture": {
      "summary": "Judges whether the design is as simple as it could be, and proposes a simpler one",
      "agent": {
        "harness": "claude-code",
        "model": "opus",
        "effort": "high"
      },
      "focus": "focus/check-architecture.md"
    }
  },
  "codex_fallback": {
    "harness": "claude-code",
    "model": "opus",
    "effort": "high"
  },
