{
  "reviewers": {
    "check-acceptance-criteria": {
      "summary": "The spec, its acceptance criteria, and the product decisions",
      "agent": { "harness": "claude-code", "model": "opus", "effort": "high" },
      "focus": "focus/check-acceptance-criteria.md"
    },
    "check-correctness": {
      "summary": "Traces concrete inputs through new logic",
      "agent": { "harness": "codex", "model": "gpt-6-astra", "effort": "high" },
      "focus": "focus/check-correctness.md"
    },
    "check-security": {
      "summary": "Trust boundaries, secrets, injection, and tenant isolation",
      "agent": { "harness": "codex", "model": "gpt-6-astra", "effort": "high" },
      "focus": "focus/check-security.md"
    },
    "check-rules": {
      "summary": "The repository's own rules and agent instructions",
      "agent": { "harness": "claude-code", "model": "opus", "effort": "default" },
      "focus": "focus/check-rules.md"
    },
    "check-docs": {
      "summary": "Docs kept up to date with the change",
      "agent": { "harness": "claude-code", "model": "opus", "effort": "default" },
      "focus": "focus/check-docs.md"
    },
    "check-supportability": {
      "summary": "Errors surfaced, traceable, and supportable",
      "agent": { "harness": "codex", "model": "gpt-6.1-sol", "effort": "high" },
      "focus": "focus/check-supportability.md"
    },
    "check-performance": {
      "summary": "Only bottlenecks unacceptably large for the change",
      "agent": { "harness": "codex", "model": "gpt-6.1-sol", "effort": "high" },
      "focus": "focus/check-performance.md"
    },
    "check-architecture": {
      "summary": "Deep modules and simpler designs; proposes an alternative",
      "agent": { "harness": "claude-code", "model": "opus", "effort": "high" },
      "focus": "focus/check-architecture.md"
    }
  },
  "codex_fallback": { "harness": "claude-code", "model": "opus", "effort": "high" },
  "synthesize": {
    "agent": { "harness": "claude-code", "model": "opus", "effort": "high" }
  }
}
